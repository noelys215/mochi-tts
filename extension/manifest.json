{
  "manifest_version": 3,
  "name": "Mochi Audio",
  "version": "0.1.0",
  "description": "Read selected page text through a local mock text-to-speech server.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mochi Audio",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
