{
  "manifest_version": 3,
  "name": "Fish Study Reader",
  "version": "0.1.0",
  "description": "Read selected page text through a local mock text-to-speech server.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fish Study Reader",
    "default_popup": "popup/popup.html"
  }
}
